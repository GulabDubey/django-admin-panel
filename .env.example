# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Move the admin off the default /admin/ path.
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO
# "Name <email>" list that receives 500 error emails.
DJANGO_ADMINS=

# HTTPS behaviour. All default to on when DJANGO_DEBUG=False.
# Turn off only for a local production-mode test over plain HTTP.
DJANGO_BEHIND_PROXY=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database (MySQL) -----------------------------------------------------
DB_NAME=django_app
DB_USER=django_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Used only by docker-compose to initialise the MySQL container.
DB_ROOT_PASSWORD=

# --- Email (error reports) ------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Razorpay -------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → endpoint https://<domain>/api/payments/webhook/
RAZORPAY_WEBHOOK_SECRET=

# --- AI blog generation ---------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5

# --- Landing page chatbot widget (leave empty to disable) -----------------
CHATBOT_WIDGET_URL=

# --- Gunicorn -------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# --- Website crawler API (web-agent) --------------------------------------
# From Docker, reach a service on the host via http://host.docker.internal:8010/...
CRAWLER_API_URL=http://127.0.0.1:8010/api/v1/extract-website-data
# Sent as "Authorization: Bearer <token>" when set.
CRAWLER_API_TOKEN=
CRAWLER_API_TIMEOUT=900

# --- Chatbot service → subscription verification API ----------------------
# Bearer token(s) the FastAPI chatbot service must send to
# POST /api/internal/chatbot/verify-subscription/. Comma-separated: to rotate,
# add the new token, switch the chatbot over, then remove the old one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHATBOT_SERVICE_TOKENS=
